FROM node:20-alpine AS frontend

WORKDIR /app

COPY Frontend/paymen_system/package.json Frontend/paymen_system/package-lock.json* ./
RUN npm ci

COPY Frontend/paymen_system/ .
RUN npm run build

FROM nginx:alpine
COPY --from=frontend /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
